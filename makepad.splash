use mod.std.*
use mod.hub;
let RunItem = {
    on_run: nil,
    name: ""
    package_name: ""
    in_studio: true
}

let RunQuest = RunItem{
    on_run: fn(id){
        hub.run( 
            {"STUDIO_HOST": hub.studio_ext_host() "STUDIO_BUILD": id.to_string() "STUDIO_CRATE": self.run "MAKEPAD": "vulkan"},
            "cargo", 
            [
                "run" "-p" "cargo-makepad" "--release" "--message-format=json" "--"
                "android" "--variant=quest" "--devices=all" "--no-icon" "--small-fonts" "run" "-p" self.run "--release"  "--message-format=json"
            ],
        )
    }
}

let RunAndroid = RunItem{
    on_run: fn(id){
        hub.run(
            {"STUDIO_HOST": hub.studio_ext_host() "STUDIO_BUILD": id.to_string() "STUDIO_CRATE": self.name "MAKEPAD": "vulkan"},
            "cargo", 
            [
                "run" "-p" "cargo-makepad" "--release" "--message-format=json" "--"
                "android"  "--no-icon" "--small-fonts" "run" "-p" self.name "--release" "--message-format=json"
            ],
        )
    }
}

let RunStudioRelease = RunItem{
    on_run: fn(id){
        hub.run(
            {"STUDIO_HOST": hub.studio_local_host() "STUDIO_BUILD": id.to_string() "STUDIO_CRATE": self.name},
            "cargo", 
            ["run" "-p" self.name "--release" "--message-format=json" "--" "--message-format=json" "--stdin-loop"],
        )
    }
}

let RunRelease = RunItem{
    on_run: fn(id){
        hub.run(
            {"STUDIO_HOST": hub.studio_local_host() "STUDIO_BUILD": id.to_string() "STUDIO_CRATE": self.run},
            "cargo", 
            ["run" "-p" self.run "--release" "--message-format=json" "--" "--message-format=json"],
        )
    }
}

let RunAichatMacosGlass = RunItem{
    backend: "macos-native"
    proof: ""
    compositing_proof: ""
    above_metal_probe: ""
    metal_probe_pattern: ""
    spacing_probe: ""
    inactive_probe: ""
    fullscreen_probe: ""
    geometry_probe: ""
    interleave_layer_probe: ""
    on_run: fn(id){
        hub.run(
            {
                "STUDIO_HOST": hub.studio_local_host()
                "STUDIO_BUILD": id.to_string()
                "STUDIO_CRATE": "makepad-example-aichat"
                "AICHAT_GLASS_BACKEND": self.backend
                "AICHAT_NATIVE_SUBSTRATE_PROOF": self.proof
                "AICHAT_NATIVE_COMPOSITING_PROOF": self.compositing_proof
                "AICHAT_NATIVE_ABOVE_METAL_PROBE": self.above_metal_probe
                "AICHAT_METAL_PROBE_PATTERN": self.metal_probe_pattern
                "AICHAT_NATIVE_SPACING_PROBE": self.spacing_probe
                "AICHAT_NATIVE_INACTIVE_PROBE": self.inactive_probe
                "AICHAT_NATIVE_FULLSCREEN_PROBE": self.fullscreen_probe
                "MAKEPAD_NATIVE_GLASS_GEOMETRY_SNAPSHOT": self.geometry_probe
                "AICHAT_NATIVE_INTERLEAVE_LAYER_PROBE": self.interleave_layer_probe
            },
            "cargo",
            ["run" "-p" "makepad-example-aichat" "--release" "--message-format=json" "--" "--message-format=json"],
        )
    }
}


let RunStudio = RunItem{
    on_run: fn(id){
        hub.run(
            {"STUDIO_HOST": hub.studio_local_host() "STUDIO_BUILD": id.to_string() "STUDIO_CRATE": self.name},
            "cargo", 
            ["run" "-p" "makepad-studio" "--release" "--message-format=json" "--" "--message-format=json"  "--bind=0.0.0.0" "--stdin-loop"],
        )
    }
}

let RunStudioExt = RunItem{
    on_run: fn(id){
        hub.run(
            {"STUDIO_HOST": hub.studio_local_host() "STUDIO_BUILD": id.to_string() "STUDIO_CRATE": self.name},
            "cargo", 
            ["run" "-p" "makepad-studio" "--release" "--message-format=json" "--" "--message-format=json" "--bind=0.0.0.0"],
        )
    }    
} 


hub.set_run_items([
    RunStudioRelease{name: "makepad-example-browser"}
    RunStudioRelease{name: "makepad-example-charts"}
    RunStudioRelease{name: "makepad-example-splash"}
    RunAndroid{name: "makepad-example-pdf"}
    RunStudioRelease{name: "makepad-example-map"}
    RunStudioRelease{name: "makepad-example-todo"}
    RunStudioRelease{name: "makepad-example-aichat"}
    RunRelease{name: "makepad-example-aichat-native", run: "makepad-example-aichat"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-proof", backend: "shader-backdrop-proof"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-blur-proof", backend: "shader-backdrop-blur-proof"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-texture-proof", backend: "shader-backdrop-texture-proof"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-screen-texture-proof", backend: "shader-backdrop-screen-texture-proof"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-scene-proof", backend: "shader-backdrop-scene-proof"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-blur-pass-proof", backend: "shader-backdrop-blur-pass-proof"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-blurred-texture-proof", backend: "shader-backdrop-blurred-texture-proof"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-refraction-proof", backend: "shader-backdrop-refraction-proof"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-interior-no-chroma", backend: "shader-backdrop-interior-no-chroma"}
    RunAichatMacosGlass{name: "makepad-example-aichat-shader-backdrop-interior", backend: "shader-backdrop-interior"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native-auto", backend: "auto"}
    RunAichatMacosGlass{name: "makepad-example-aichat-apple-native-underlay", backend: "apple-native-underlay"}
    RunAichatMacosGlass{name: "makepad-example-aichat-apple-native-underlay-clear", backend: "apple-native-underlay-clear"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native", backend: "macos-native"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native-clear", backend: "macos-native-clear"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native-clear-spacing-probe", backend: "macos-native-clear", spacing_probe: "animate"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native-clear-inactive-probe", backend: "macos-native-clear", inactive_probe: "1"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native-clear-fullscreen-probe", backend: "macos-native-clear", fullscreen_probe: "1"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native-clear-geometry-probe", backend: "macos-native-clear", geometry_probe: "1"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native-clear-interleave-layer-probe", backend: "macos-native-clear", interleave_layer_probe: "1"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native-clear-proof-stripes", backend: "macos-native-clear", proof: "stripes", compositing_proof: "transparent-overlay"}
    RunAichatMacosGlass{name: "makepad-example-aichat-macos-native-above-metal-probe", backend: "shader", above_metal_probe: "clear", metal_probe_pattern: "moving-pattern"}
    RunStudio{name: "makepad-studio"} 
    RunStudioExt{name: "makepad-studio-ext"} 
    RunStudioRelease{name: "makepad-example-xr"}
    RunQuest{name: "makepad-example-xr-quest", run:"makepad-example-xr"}
])
