            LinkCol{lb6 := Label{text: "^" draw_text.color: #x66ffaa draw_text.text_style.font_size: 16}}
            LinkCol{lb7 := Label{text: "^" draw_text.color: #x66ffaa draw_text.text_style.font_size: 16}}
            LinkCol{lb8 := Label{text: "" draw_text.color: #x66ffaa draw_text.text_style.font_size: 16}}
