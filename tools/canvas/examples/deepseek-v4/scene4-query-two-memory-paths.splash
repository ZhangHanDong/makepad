            LinkCol{lb12 := Label{text: "" draw_text.color: #x66ffaa draw_text.text_style.font_size: 16}}
        }

        // --- Cb & Zb row ---
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            Label{width: 90 text: "Cb & Zb" draw_text.color: #x66ffaa draw_text.text_style.font_size: 12}
            Cell{draw_bg.color: #x44aa77 Label{text: "0" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "1" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "2" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "3" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "4" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "5" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "6" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "7" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "8" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "9" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "10" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "11" draw_text.color: #xfff}}
            Cell{draw_bg.color: #x44aa77 Label{text: "12" draw_text.color: #xfff}}
        }
    }

    RoundedView{width: Fill height: Fit draw_bg.color: #x1a1a28 draw_bg.radius: 8. padding: Inset{left: 20. right: 20. top: 12. bottom: 12.} flow: Down spacing: 4
        Label{text: "Connection rules (DeepSeek V4 C4A -- per vllm blog)" draw_text.color: #x66ffaa draw_text.text_style.font_size: 11}
        Label{text: "sliding window:  q attends last 128 raw k(v) (demo: 0..q)" draw_text.color: #xffaa66 draw_text.text_style.font_size: 11}
        Label{text: "C4A compressed:  C_i = weighted_sum(tokens[4i, 4i+8)), RoPE pos = 4i+3, top-512 selection" draw_text.color: #xffcc44 draw_text.text_style.font_size: 11}
        Label{text: "causal:  q attends C_i only if q >= 4i+7   ->   C0 needs q>=7, C1 needs q>=11, C2 needs q>=15" draw_text.color: #xcc88ff draw_text.text_style.font_size: 11}
        narr := Label{width: Fill text: "" draw_text.color: #xeeeeff draw_text.text_style.font_size: 12}
    }
}
